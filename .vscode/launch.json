{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (VSCodium)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${env:LOCALAPPDATA}/Programs/VSCodium/VSCodium.exe",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=n2ns.wsl-remote",
        "--disable-extension=jeanp413.open-remote-wsl"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
